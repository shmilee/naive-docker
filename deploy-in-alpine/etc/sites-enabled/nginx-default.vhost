server {
    listen       80 default;
    listen       [::]:80 default;
    server_name  {{domain-name}};

    # Everything is a 404
    location / {
        return 404;
    }

    # You may need this to prevent return 404 recursion.
    location = /404.html {
        internal;
    }
}

server {
    listen       80;
    listen       [::]:80;
    server_name  def.{{domain-name}};
    # enforce https
    return 301 https://$server_name$request_uri;
}

server {
    listen  443 ssl http2;
    listen  [::]:443 ssl http2;
    server_name def.{{domain-name}};

    ssl_certificate       /srv/etc/ssl-certs/server-adf.crt;
    ssl_certificate_key   /srv/etc/ssl-certs/server-adf.key;
    access_log  /srv/log/nginx-default-access.log main buffer=32k flush=1m;
    error_log   /srv/log/nginx-default-error.log notice;

    location ~ /\.ht {
        deny  all;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        return 500;
    }

    location / {
        return 404;
    }

    location = /404.html {
        internal;
    }

    location /status {
        stub_status on;
        access_log on;
    }
}
