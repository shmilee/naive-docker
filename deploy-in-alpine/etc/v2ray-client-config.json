{

  "log" : {
    // "debug", "info", "warning", "error", "none"
    "loglevel": "warning"
  },

  "inbounds": [
    {
      "tag": "socks-8a87",
      "port": 8087,
      // "listen": "127.0.0.1",
      "protocol": "socks",
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"]
      },
      "settings": {
        "auth": "noauth"
      }
    },
    {
      "tag": "socks-8b87",
      "port": 8187,
      // "listen": "127.0.0.1",
      "protocol": "socks",
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"]
      },
      "settings": {
        "auth": "noauth"
      }
    }
  ],

  "outbounds": [
    {
      "tag": "simple-vmess",
      "protocol": "vmess",
      "settings": {
        "vnext": [
          {
            "address": "{{ip-addr}}",
            "port": {{vport_init}},
            "users": [
              {
                "id": "{{UUID_1}}",
                "alterId": 0
              }
            ]
          }
        ]
      },
      "mux": {"enabled": true}
    },
    {
      "tag": "trojan-tls",
      "protocol": "trojan",
      "settings": {
        "servers": [
          {
            "address": "free.{{domain-name}}",
            "port": {{vport_troj}},
            "password": "{{troj-password}}"
          }
        ]
      },
      "streamSettings": {
          "network": "tcp",
          "security": "tls"
      }
    },
    {
      "tag": "ws-vmess",
      "protocol": "vmess",
      "settings": {
        "vnext": [
          {
            "address": "fly.{{domain-name}}",
            "port": 443,
            "users": [
              {
                "id": "{{UUID_2}}",
                "alterId": 0
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "wsSettings": {
          "path": "/{{v2raypath}}"
        }
      }
    }
  ],

  "routing": {
    "strategy": "rules",
    "settings": {
      "rules": [
        {
          "type": "field",
          "inboundTag": [
            "socks-8a87"
          ],
          //"outboundTag": "simple-vmess"
          "outboundTag": "trojan-tls"
        },
        {
          "type": "field",
          "inboundTag": [
            "socks-8b87"
          ],
          "outboundTag": "ws-vmess"
        }
      ]
    }
  }

}
