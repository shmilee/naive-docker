{
  "log" : {
    "access": "/srv/log/v2ray-access.log",
    "error": "/srv/log/v2ray-error.log",
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "port": {{vport_init}}, // 服务器监听端口
      "protocol": "vmess",    // 主传入协议
      "settings": {
        "clients": [
          {
            "id": "{{UUID_1}}",  // 用户 ID，客户端与服务器必须相同
            "alterId": 0
          }
        ]
      }
    },
    {
      "port": {{vport_troj}},
      "protocol": "trojan",
      "settings": {
          "clients": [
              {
                  "password":"{{troj-password}}",
                  "email": "loveee@vvv2fly.org"
              }
          ]
      },
      "streamSettings": {
          "network": "tcp",
          "security": "tls",
          "tlsSettings": {
              "alpn": [
                  "http/1.1"
              ],
              "certificates": [
                  {
                      "certificateFile": "/srv/etc/ssl-certs/server-ztr.crt",
                      "keyFile": "/srv/etc/ssl-certs/server-ztr.key"
                  }
              ]
          }
      }
    },
    {
      "port": 44944,
      "listen": "127.0.0.1",
      "protocol": "vmess",
      "settings": {
        "clients": [
          {
            "id": "{{UUID_2}}",
            "alterId": 0
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
        "path": "/{{v2raypath}}"
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",  // 主传出协议
      "settings": {}
    }
  ]
}
